{
  "name": "splitit",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "serve:out": "node scripts/serve-out.mjs",
    "pretest": "npm run test:unit && npm run test:rls && npm run build:test",
    "test:rls": "tsx --test --test-concurrency=1 test/rls.test.mjs test/realistic-rls.test.mjs test/group-participants-rls.test.mjs test/waitlist-rls.test.mjs",
    "build:test": "NEXT_PUBLIC_SUPABASE_URL= NEXT_PUBLIC_SUPABASE_ANON_KEY= NEXT_PUBLIC_UPDATE_MANIFEST_URL= NEXT_PUBLIC_APP_URL= VERCEL_PROJECT_PRODUCTION_URL= next build",
    "test:unit": "tsx --test test/debt-simplification.test.mjs test/currency.test.mjs test/ocr.test.mjs test/realistic-scenarios.test.mjs",
    "verify:prod": "node scripts/verify-production.mjs",
    "verify:realtime": "node scripts/verify-realtime.mjs",
    "canary": "node scripts/canary.mjs"
  },
  "dependencies": {
    "@capacitor-community/contacts": "^8.0.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/push-notifications": "^8.1.2",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.6",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.11",
    "lucide-react": "^0.454.0",
    "next": "^16.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@electric-sql/pglite": "^0.5.4",
    "@playwright/test": "^1.62.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.9",
    "typescript": "^5.6.3"
  }
}
