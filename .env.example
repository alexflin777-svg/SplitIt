# Скопируйте в .env.local и заполните значениями своего проекта Supabase.
#
# Пустые значения — это рабочее состояние: приложение честно скажет, что
# работает локально без бэкенда, и покажет баннер на экране авторизации.
# Чего делать НЕЛЬЗЯ — вписывать сюда выдуманные значения вроде
# https://placeholder-splitit.supabase.co: они вшиваются в сборку, приложение
# начинает ходить в несуществующий домен, а ошибки выглядят как рабочий офлайн.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Публичный адрес приложения — используется в пригласительных ссылках.
NEXT_PUBLIC_APP_URL=

# Канал обновлений: адрес JSON-манифеста { version, releaseNotes, downloadUrl, downloadSize }.
# Пусто — экран обновлений честно скажет, что канал не настроен.
NEXT_PUBLIC_UPDATE_MANIFEST_URL=
